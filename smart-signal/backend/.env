# Allowed CORS origins (where your frontend is hosted)
# For local dev, this is usually http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# 2. Traffic Signal Config Overrides (Optional)
# You can override the defaults set in config.py here.
MAX_GREEN_S=120
EMPTY_CUTOFF_S=35
MIN_GREEN_S=10
DEMO_SPEED=1

# 3. Vision Settings
# yolo (real cameras) OR motion (for toy cars / cardboard model)
DETECTOR=yolo
SOURCE_DEFAULT=1
