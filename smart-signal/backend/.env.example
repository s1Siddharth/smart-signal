# ==========================================
# Backend Environment Variables — EXAMPLE
# Copy this to .env and fill in your values.
# NEVER commit your actual .env file.
# ==========================================

# 1. Security & Authentication
# Comma-separated list of emails allowed to log in
ALLOWED_EMAILS=your_email@gmail.com,demo@example.com

# Raw JSON string of your Firebase Service Account private key
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# If left blank, the backend runs in DEV MODE (bypasses real auth — for local testing only)
FIREBASE_SERVICE_ACCOUNT_JSON=''

# Allowed CORS origins (where your frontend is hosted)
CORS_ORIGINS=http://localhost:5173

# 2. Traffic Signal Config Overrides
MAX_GREEN_S=120
EMPTY_CUTOFF_S=35
MIN_GREEN_S=10
YELLOW_S=3
ALL_RED_S=1
STARVATION_WAIT_S=150
DEMO_SPEED=1

# 3. Vision Settings
# Use "yolo" for real camera/YOLO detection, "motion" for OpenCV motion fallback
DETECTOR=yolo
# Camera index (0 = default webcam) or path to video file or RTSP URL
SOURCE_DEFAULT=0
CAMERA_INDEX=0
# YOLO model path (relative to backend/ dir or absolute)
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
YOLO_IMGSZ=640
SMOOTHING_WINDOW_S=1.5
PROCESS_EVERY_N_FRAMES=1

# 4. Database
DB_PATH=smart_signal.db

# 5. WebSocket
WS_BROADCAST_HZ=5
WS_AUTH_TIMEOUT_S=5
