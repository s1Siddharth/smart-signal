# ==========================================
# Backend Environment Variables (.env)
# ==========================================

# 1. Security & Authentication
# Comma-separated list of emails allowed to log in (e.g. your email + demo email)
ALLOWED_EMAILS=your_email@gmail.com,demo@example.com

